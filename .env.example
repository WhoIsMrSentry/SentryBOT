# SentryBOT local environment example
# Copy this file to .env and replace secret placeholders locally.

SENTRYBOT_AGENT_AUTH_TOKEN=replace-with-local-agent-token
SENTRYBOT_VLM_AUTH_TOKEN=replace-with-local-vlm-token
SENTRYBOT_TTS_AUTH_TOKEN=replace-with-local-tts-token
SENTRY_API_KEY=replace-with-local-api-key
OLLAMA_HOST=http://whoismrsentry.local:11434
OLLAMA_BASE_URL=http://whoismrsentry.local:11434
SENTRYBOT_OLLAMA_BASE_URL=http://whoismrsentry.local:11434
SENTRYBOT_OLLAMA_MODEL=qwen3.5:9b
