[Unit]
Description=SentryBOT Raspberry Pi Robot Runtime
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=-/etc/sentrybot/sentrybot.env
ExecStartPre=/bin/bash -lc 'cd "$SENTRYBOT_ROOT" && ${SENTRYBOT_ROOT}/.venv/bin/python tools/pi_runtime_readiness.py --fail-on-required'
ExecStart=/bin/bash -lc 'cd "$SENTRYBOT_ROOT" && exec ${SENTRYBOT_ROOT}/.venv/bin/python -m uvicorn modules.gateway.xGatewayService:create_app --factory --host ${SENTRYBOT_HOST:-0.0.0.0} --port ${SENTRYBOT_PORT:-8080}'
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
User=pi
Group=pi
SupplementaryGroups=audio video gpio i2c spi dialout
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
