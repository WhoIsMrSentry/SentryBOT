# SentryBOT systemd environment example
# NOTE: only list env vars that the Python code actually reads
# (audit R57 removed dead keys). Verify against:
#   deploy/systemd/sentrybot.service (shell-consumed: ROOT/HOST/PORT)
#   modules/common/runtime_target.py, modules/gateway/services/bootstrap_config.py,
#   modules/system_control/config_center/runtime_secrets.py

# --- consumed by sentrybot.service shell line (not by Python) ---
SENTRYBOT_ROOT=__PROJECT_ROOT__
SENTRYBOT_HOST=0.0.0.0
SENTRYBOT_PORT=8080

# --- runtime / autostart ---
SENTRYBOT_PROFILE=pi_robot
# Autostart is controlled by these (bootstrap_config.py); 1/0:
SENTRYBOT_FORCE_AUTOSTART=
SENTRYBOT_DISABLE_AUTOSTART=

# Required when gateway is reachable on LAN
SENTRY_API_KEY=replace-with-strong-gateway-api-key
SENTRYBOT_AGENT_AUTH_TOKEN=replace-with-strong-agent-token
SENTRYBOT_VLM_AUTH_TOKEN=replace-with-strong-vlm-token
SENTRYBOT_TTS_AUTH_TOKEN=replace-with-strong-tts-token

# --- Ollama host selection (first non-empty wins in ollama_url.ensure_*) ---
OLLAMA_HOST=http://whoismrsentry.local:11434
SENTRYBOT_OLLAMA_BASE_URL=http://whoismrsentry.local:11434

# --- model overrides (tri_layer.py / agent_turn.py / agent_api_compat.py) ---
SENTRYBOT_MODEL=qwen3.5:9b
SENTRYBOT_LLM_MODEL=qwen3.5:9b
SENTRYBOT_OLLAMA_MODEL=qwen3.5:9b

GOOGLE_API_KEY=
PYTHONUNBUFFERED=1
