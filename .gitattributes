# Normalize text files to LF in the repo; avoid Windows CRLF phantom diffs.
* text=auto eol=lf

# Explicit binary types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.db binary
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
