# Copy to modules/ollama/.env locally (DO NOT commit secrets to git)

# Optional provider override: ollama | google_ai_studio
LLM_PROVIDER=ollama

# External Ollama host/IP
OLLAMA_BASE_URL=http://<remote-ollama-host>:11434

# Default base model used by the Ollama module
OLLAMA_MODEL=gemma-4-26B-A4B

# Optional request timeout (seconds)
# OLLAMA_REQUEST_TIMEOUT=60

# Google API key for Gemini / Google AI Studio (used when provider=google_ai_studio)
GOOGLE_API_KEY=

# Optional: Google model override
# GOOGLE_MODEL=gemini-1.5-flash
