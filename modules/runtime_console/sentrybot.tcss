/* SentryBOT Control Center - High-Density Sentry Crimson TCSS Stylesheet */

* {
    scrollbar-color: $primary $secondary;
    scrollbar-color-hover: $primary $panel;
    scrollbar-color-active: $primary $surface;
    scrollbar-size: 1 1;
}

Screen {
    background: $background;
    color: auto;
    layout: vertical;
}

/* =========================================================================
   HEADER BAR
   ========================================================================= */

#app_header {
    dock: top;
    height: 3;
    background: $surface;
    border-bottom: heavy $primary;
    padding: 0 1;
    layout: horizontal;
    align: center middle;
}

#header_title {
    width: auto;
    margin-right: 2;
    text-style: bold;
    color: #FA1E4E;
}

#header_status_badge {
    width: auto;
    height: 1;
    content-align: center middle;
    text-style: bold;
    margin-right: 2;
    padding: 0 1;
    background: $secondary;
    color: #ffffff;
}

#header_info_bar {
    width: 1fr;
    content-align: right middle;
    color: #cccccc;
}

/* =========================================================================
   TABS & CONTAINERS
   ========================================================================= */

TabbedContent {
    height: 1fr;
}

ContentSwitcher {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0;
}

Tabs {
    background: $surface;
    border-bottom: solid $secondary;
    height: 3;
}

Tab {
    padding: 0 2;
    color: #a88d94;
    text-style: bold;
    height: 3;
    content-align: center middle;
}

Tab:hover {
    background: $panel;
    color: #ffffff;
}

Tab.-active {
    background: $secondary;
    color: #ffffff;
    text-style: bold;
}

Tabs > Underline {
    display: none;
}

Underline {
    display: none;
}

TabMain, TabLogs, TabTelemetry, TabControls, TabConfig {
    height: 1fr;
    width: 100%;
}

/* =========================================================================
   TAB 1: MAIN DASHBOARD (HIGH DENSITY & RICH TELEMETRY)
   ========================================================================= */

#main_container {
    height: 100%;
    width: 100%;
    layout: vertical;
    padding: 1;
    overflow-y: auto;
}

/* 5-Item Hero Hardware Resource Strip */
#main_hero_bar {
    layout: horizontal;
    height: 4;
    margin-bottom: 1;
    background: $surface;
    border: round $secondary;
    padding: 0 1;
    align: center middle;
}

.hero_metric {
    width: 1fr;
    content-align: center middle;
    layout: vertical;
    border-right: solid $secondary;
    padding: 0 1;
}

.hero_metric_last {
    width: 1fr;
    content-align: center middle;
    layout: vertical;
    padding: 0 1;
}

.hero_label {
    color: #FA1E4E;
    text-style: bold;
}

.hero_value {
    color: #ffffff;
    text-style: bold;
}

/* Live Dynamic Historical Resource Waveforms (Sparklines) */
#main_sparkline_strip {
    layout: horizontal;
    height: 5;
    margin-bottom: 1;
    background: $surface;
    border: round $secondary;
    padding: 0 1;
    align: center middle;
}



.sparkline_box {
    width: 1fr;
    layout: vertical;
    border-right: solid $secondary;
    padding: 0 1;
    height: 100%;
}

.sparkline_box_last {
    width: 1fr;
    layout: vertical;
    padding: 0 1;
    height: 100%;
}

.sparkline_title {
    color: #FA1E4E;
    text-style: bold;
    height: 1;
}

Sparkline {
    height: 2;
}

/* Subsystem Health Grid (3x2 Matrix) */
#services_grid_title {
    color: #FA1E4E;
    text-style: bold;
    margin-bottom: 1;
}

#services_grid {
    layout: grid;
    grid-size: 3 2;
    grid-gutter: 1;
    height: 14;
    margin-bottom: 1;
}

ServiceCard, .service_card {
    background: $panel;
    border: solid $secondary;
    padding: 1;
    height: 6;
    layout: vertical;
}

ServiceCard:hover, .service_card:hover {
    border: solid $primary;
    background: $surface;
}

.service_card_header {
    layout: horizontal;
    height: 1;
    margin-bottom: 1;
}

.service_name {
    text-style: bold;
    width: 1fr;
    color: #FA1E4E;
}

.service_badge {
    text-style: bold;
    padding: 0 1;
    background: $secondary;
    color: #ffffff;
    border: solid $secondary;
}

.badge_ok {
    background: $success;
    color: #000000;
    border: none;
}

.badge_warn {
    background: $warning;
    color: #000000;
    border: none;
}

.badge_err {
    background: $error;
    color: #ffffff;
    border: none;
}

.badge_pc {
    background: $secondary;
    color: #FA1E4E;
    border: solid $primary;
}

.service_msg {
    color: #cccccc;
    height: 2;
    overflow: hidden;
}

/* Multi-Section Telemetry Row */
#main_middle_split {
    layout: horizontal;
    height: 13;
    margin-bottom: 1;
}

#companion_panel {
    width: 1fr;
    height: 100%;
    background: $surface;
    border: round $secondary;
    padding: 1;
    margin-right: 1;
}

#attention_panel {
    width: 1fr;
    height: 100%;
    background: $surface;
    border: round $secondary;
    padding: 1;
    margin-right: 1;
}

#traffic_panel {
    width: 1fr;
    height: 100%;
    background: $surface;
    border: round $secondary;
    padding: 1;
}

.panel_title {
    color: #FA1E4E;
    text-style: bold;
    margin-bottom: 1;
    border-bottom: solid $secondary;
    padding-bottom: 0;
}

#companion_content, #attention_content, #traffic_content {
    background: $panel;
    padding: 1;
    color: #cccccc;
}

/* Action Control Bar */
#main_action_bar {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
    align: center middle;
}

.action_button {
    margin-right: 1;
    min-width: 14;
    text-style: bold;
}

.action_button:hover {
    background: $primary;
    color: #000000;
    border: solid $primary;
    text-style: bold;
}

/* =========================================================================
   TAB 2: FULL-WIDTH LIVE LOGS
   ========================================================================= */

#logs_container {
    height: 100%;
    width: 100%;
    layout: vertical;
    padding: 1;
}

#logs_stats_bar {
    layout: horizontal;
    height: 1;
    margin-bottom: 1;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $secondary;
}

#log_stats_label {
    color: #cccccc;
}

#logs_toolbar {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
    padding: 0;
    align: center middle;
}

#log_search_input {
    width: 1fr;
    margin-right: 1;
    border: tall $secondary;
    height: 3;
}

#log_search_input:focus {
    border: tall $primary;
}

.filter_btn {
    min-width: 8;
    margin-right: 1;
    height: 3;
}

#log_scroll_toggle {
    min-width: 17;
    margin-right: 1;
    height: 3;
}

#log_clear_btn {
    min-width: 10;
    height: 3;
}

#live_rich_log {
    height: 1fr;
    background: $background;
    border: solid $secondary;
    padding: 0 1;
    overflow-y: scroll;
    overflow-x: auto;
}

#live_rich_log:focus {
    border: solid $primary;
}

/* =========================================================================
   TAB 3: DEEP HARDWARE & TELEMETRY
   ========================================================================= */

#telemetry_container {
    height: 100%;
    width: 100%;
    layout: vertical;
    padding: 1;
    overflow-y: auto;
}

#telemetry_title {
    color: #FA1E4E;
    text-style: bold;
    margin-bottom: 1;
}

#telemetry_spark_strip {
    layout: horizontal;
    height: 5;
    margin-bottom: 1;
    background: $surface;
    border: round $secondary;
    padding: 0 1;
    align: center middle;
}

.telem_spark_box {
    width: 1fr;
    layout: vertical;
    border-right: solid $secondary;
    padding: 0 1;
    height: 100%;
}

.telem_spark_box_last {
    width: 1fr;
    layout: vertical;
    padding: 0 1;
    height: 100%;
}

.telem_spark_title {
    color: #FA1E4E;
    text-style: bold;
    height: 1;
}

#telemetry_grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1;
    height: 28;
}

.telemetry_card {
    background: $panel;
    border: round $secondary;
    padding: 1;
    layout: vertical;
}

.telemetry_card:hover {
    border: round $primary;
}

.telemetry_card_title {
    color: #FA1E4E;
    text-style: bold;
    margin-bottom: 1;
    border-bottom: solid $secondary;
}

#telem_imu_content, #telem_bridge_content, #telem_vision_content, #telem_ai_content {
    height: 1fr;
    color: #cccccc;
}

#telem_controls_bar {
    height: 3;
    layout: horizontal;
    background: $surface;
    border: round $secondary;
    padding: 0 1;
    align: center middle;
    margin-bottom: 1;
}

#telem_live_log {
    height: 1fr;
    background: $surface;
    padding: 0 1;
    overflow-y: scroll;
}

/* =========================================================================
   TAB 4: PROCEDURES & ACTION CONTROLS
   ========================================================================= */

#controls_container {
    height: 100%;
    width: 100%;
    layout: vertical;
    padding: 1;
}

#controls_title {
    color: #FA1E4E;
    text-style: bold;
    margin-bottom: 1;
}

#controls_split {
    layout: horizontal;
    height: 1fr;
}

#controls_action_panel {
    width: 38;
    height: 100%;
    background: $surface;
    border: round $secondary;
    padding: 1;
    margin-right: 1;
    layout: vertical;
    overflow-y: auto;
}

.controls_section_title {
    color: #FA1E4E;
    text-style: bold;
    margin-bottom: 1;
    border-bottom: solid $secondary;
}

.ctrl_action_btn {
    margin-bottom: 1;
    width: 100%;
    text-style: bold;
}

#controls_log_panel {
    width: 1fr;
    height: 100%;
    background: $surface;
    border: round $secondary;
    padding: 1;
    layout: vertical;
}

#controls_log_header {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
    align: center middle;
}

#controls_log_header Label {
    width: 1fr;
}

#btn_ctrl_clear_log {
    min-width: 14;
}

#controls_rich_log {
    height: 1fr;
    background: $background;
    border: solid $secondary;
    padding: 0 1;
    overflow-y: scroll;
}

#controls_quick_cmd_bar {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align: center middle;
}

#controls_cmd_input {
    width: 1fr;
    margin-right: 1;
    border: tall $secondary;
}

#controls_cmd_input:focus {
    border: tall $primary;
}

#btn_ctrl_send_cmd {
    min-width: 16;
}

/* =========================================================================
   TAB 5: CONFIG EDITOR
   ========================================================================= */

#config_container {
    height: 100%;
    width: 100%;
    layout: horizontal;
    padding: 1;
}

#config_file_tree_container {
    width: 36;
    height: 100%;
    background: $surface;
    border: round $secondary;
    padding: 1;
    margin-right: 1;
}

#config_tree_title {
    color: #FA1E4E;
    text-style: bold;
    margin-bottom: 1;
    border-bottom: solid $secondary;
}

#config_search_input {
    margin-bottom: 1;
    border: tall $secondary;
}

#config_search_input:focus {
    border: tall $primary;
}

#config_file_list {
    height: 1fr;
    background: $background;
    border: solid $secondary;
}

#config_editor_container {
    width: 1fr;
    height: 100%;
    background: $surface;
    border: round $secondary;
    padding: 1;
    layout: vertical;
}

#config_editor_header {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
    align: center middle;
}

#config_file_path_label {
    width: 1fr;
    color: #FA1E4E;
    text-style: bold;
}

#config_lang_badge {
    min-width: 12;
    padding: 0 1;
    background: $secondary;
    margin-right: 1;
    content-align: center middle;
    text-style: bold;
}

#config_theme_btn {
    min-width: 18;
    margin-right: 1;
    background: $secondary;
    color: #ffffff;
    text-style: bold;
}

#config_theme_btn:hover {
    background: $primary;
    color: #000000;
}

#config_save_btn {
    min-width: 16;
    background: $primary;
    color: #000000;
    text-style: bold;
}

#config_text_area {
    height: 1fr;
    border: solid $secondary;
}

#config_text_area:focus {
    border: solid $primary;
}

/* =========================================================================
   MODAL DIALOGS (SYSINFO / THEME)
   ========================================================================= */

SysInfoModal, ThemeSelectorModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#sysinfo_dialog {
    width: 82;
    height: 32;
    background: $panel;
    border: heavy $primary;
    padding: 1 2;
    layout: vertical;
}

#theme_dialog {
    width: 100%;
    height: 100%;
    background: $surface;
    border: double $primary;
    padding: 1 2;
    layout: vertical;
}

#sysinfo_title, #theme_dialog_title {
    color: #FA1E4E;
    text-style: bold;
    content-align: center middle;
    margin-bottom: 1;
}

#theme_hint {
    margin-bottom: 1;
    content-align: center middle;
    color: #aaaaaa;
}

#theme_option_list {
    height: 1fr;
    background: $surface;
    border: solid $secondary;
}



#theme_footer_bar {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align: center middle;
}

.theme_footer_btn {
    margin: 0 1;
    min-width: 16;
}

#sysinfo_scroll {
    height: 1fr;
    overflow-y: auto;
}

#sysinfo_close_btn {
    dock: bottom;
    margin-top: 1;
    width: 100%;
    background: $primary;
    color: #000000;
    text-style: bold;
}

/* Global Footer */
Footer {
    background: $surface;
    border-top: solid $secondary;
}
