// Graphviz Architecture: modules/common
// SentryBOT V5 - Shared Architecture Foundation
digraph common_module {
    graph [rankdir=TB, bgcolor="#0f172a", fontname="Segoe UI, Arial, sans-serif", fontcolor="#f8fafc", compound=true, pad="0.5"];
    node [shape=box, style="filled,rounded", fontname="Segoe UI, Arial, sans-serif", fontsize=10, penwidth=1.5];
    edge [fontname="Segoe UI, Arial, sans-serif", fontsize=9, color="#94a3b8", fontcolor="#cbd5e1", penwidth=1.2];

    subgraph cluster_common {
        label = "modules.common (Cross-Cutting Foundation)";
        style = "filled,rounded";
        fillcolor = "#1e293b";
        color = "#38bdf8";
        fontcolor = "#38bdf8";
        fontsize = 12;

        subgraph cluster_config_policy {
            label = "Configuration & Policy Management";
            fillcolor = "#0f172a";
            color = "#0284c7";
            fontcolor = "#7dd3fc";

            cfg_loader [label="config_loader\n- load_agent_config()\n- load_ai_provider_config()\n- deep_merge()", fillcolor="#1e3a5f", fontcolor="#f8fafc", color="#38bdf8"];
            model_policy [label="model_policy\n- ModelPolicy (Thread-safe)\n- get_provider_config()\n- set_strict_single_model()", fillcolor="#1e3a5f", fontcolor="#f8fafc", color="#38bdf8"];
            ollama_url [label="ollama_url\n- normalize_ollama_url()\n- is_bad_ollama_url()\n- default_ollama_base_url()", fillcolor="#1e3a5f", fontcolor="#f8fafc", color="#38bdf8"];
        }

        subgraph cluster_events_comm {
            label = "Events & Inter-Module Communication";
            fillcolor = "#0f172a";
            color = "#0d9488";
            fontcolor = "#5eead4";

            event_bus [label="robot_event_bus\n- RobotEventBus\n- Event publishing\n- Subscribe channels", fillcolor="#134e4a", fontcolor="#f8fafc", color="#2dd4bf"];
            http_client [label="http_client\n- AsyncHTTPClient / SyncHTTPClient\n- Segment Circuit Breaker\n- RetryPolicy", fillcolor="#134e4a", fontcolor="#f8fafc", color="#2dd4bf"];
            router_factory [label="router_factory\n- RouterFactory / create_router()\n- RateLimitMiddleware (429)\n- Healthz & CRUD Builders", fillcolor="#134e4a", fontcolor="#f8fafc", color="#2dd4bf"];
        }

        subgraph cluster_lifecycle_state {
            label = "Service Lifecycle & Persistence";
            fillcolor = "#0f172a";
            color = "#d97706";
            fontcolor = "#fcd34d";

            service_base [label="service_base\n- ServiceBase / AsyncServiceBase\n- BackgroundTaskMixin\n- start() / stop()", fillcolor="#78350f", fontcolor="#f8fafc", color="#f59e0b"];
            persistence [label="persistence\n- SQLiteBackend (GLOB)\n- JSONBackend (Atomic)\n- MemoryBackend", fillcolor="#78350f", fontcolor="#f8fafc", color="#f59e0b"];
            health_check [label="health\n- HealthChecker.run()\n- HealthResponse (.ok)\n- System Probe Helpers", fillcolor="#78350f", fontcolor="#f8fafc", color="#f59e0b"];
        }

        subgraph cluster_domain_helpers {
            label = "Robotics Domain Helpers";
            fillcolor = "#0f172a";
            color = "#7c3aed";
            fontcolor = "#c4b5fd";

            emotion_vocab [label="emotion_vocab\n- Affective Vocabulary Map\n- Joy, Sorrow, Anger, Fear...", fillcolor="#4c1d95", fontcolor="#f8fafc", color="#a78bfa"];
            latency_trace [label="latency_trace\n- Pipeline Latency Profiler\n- TTFT & Actuation Ticks", fillcolor="#4c1d95", fontcolor="#f8fafc", color="#a78bfa"];
            target_runtime [label="runtime_target\n- detect_runtime_target()\n- read_hardware_pressure()\n- status()", fillcolor="#4c1d95", fontcolor="#f8fafc", color="#a78bfa"];
        }
    }

    // Inter-component flows
    cfg_loader -> model_policy [label=" feeds raw yaml"];
    model_policy -> ollama_url [label=" resolves base url"];
    service_base -> router_factory [label=" registers routes"];
    service_base -> health_check [label=" status provider"];
    event_bus -> latency_trace [label=" timestamps events"];
    router_factory -> http_client [label=" proxies downstream"];
}
