# Copy to `modules/ollama/.env` locally (DO NOT commit secrets to git)
# Set your Google API key for Gemini / Google AI Studio
GOOGLE_API_KEY=

# Optional: other Google-related envs
# GOOGLE_PROJECT=your-project-id

# Note: The loader will only read this .env when `llm.provider` in
# `modules/ollama/config/config.yml` is set to `google_ai_studio` (or similar).
