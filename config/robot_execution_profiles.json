{
  "schema": "sentrybot.robot_execution_profiles.v2",
  "active_mode": "raspberry_pi",
  "profiles": {
    "raspberry_pi": {
      "description": "Raspberry Pi 5 robot runtime.",
      "allow_real_hardware": true,
      "allowed_risks": ["none", "low", "medium"],
